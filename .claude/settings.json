{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/notes-gate.py\" --hook",
            "timeout": 30,
            "statusMessage": "Checking the next release has its notes"
          }
        ]
      }
    ]
  }
}
