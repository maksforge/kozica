{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" fetch -q origin main 2>/dev/null; python3 \"$CLAUDE_PROJECT_DIR/scripts/notes-gate.py\" --pending",
            "timeout": 30,
            "statusMessage": "Checking the next release has its notes"
          }
        ]
      }
    ]
  }
}
