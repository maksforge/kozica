{
  "version": 8,
  "glyphs": "asset://map/glyphs/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f2efe9" } },
    {
      "id": "water", "type": "fill", "source": "region", "source-layer": "water",
      "paint": { "fill-color": "#9cc3e6" }
    },
    {
      "id": "ways", "type": "line", "source": "region", "source-layer": "ways",
      "paint": { "line-color": "#7a5c3e", "line-width": 1.2 }
    },
    {
      "id": "trails", "type": "line", "source": "region", "source-layer": "ways",
      "filter": ["has", "colour"],
      "paint": {
        "line-color": [
          "match", ["get", "colour"],
          "red", "#d62828", "blue", "#1d4ed8", "green", "#2e8b3a", "yellow", "#e6b800", "black", "#1a1a1a",
          "#9b4dca"
        ],
        "line-width": 3
      }
    },
    {
      "id": "peaks", "type": "symbol", "source": "region", "source-layer": "peaks",
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 13 },
      "paint": { "text-color": "#333333", "text-halo-color": "#ffffff", "text-halo-width": 1 }
    }
  ]
}
