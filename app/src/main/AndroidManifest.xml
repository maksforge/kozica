<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- MapLibre declares these; ADR-0008 allows none of them. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <uses-feature android:name="android.hardware.wifi" tools:node="remove" />

    <!--
        Asked for only by the position button (docs/phase-2.md § 4). The features are declared so
        Play never derives them from the permissions as required: the position is optional to the map.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!--
        Hike recording's `location` foreground service and its notification (docs/phase-6.md § 2).
        Notifications are asked at the first Record, never at launch.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        The <intent> entries are for hand-offs to the phone app (DIAL on tel:), a mail app, Play and
        a browser. None of the launches needs them — package visibility has never blocked
        `startActivity`, and each launch is a try/catch around `ActivityNotFoundException`. What
        visibility *does* block is `resolveActivity`, which would answer "no mail app" on every phone
        that has one. Nothing performs such a pre-check today; these entries exist so one added later
        cannot silently lie.

        The three <package> entries are the Safety screen's rescue apps, and they are load-bearing:
        `getLaunchIntentForPackage` returns null for a package this app cannot see, and that null is
        how the screen tells an installed app from a missing one.

        The two SEND entries are load-bearing too: ui/common/Share.kt grants each app that takes a
        share its read access ahead of the share sheet, and lists them through these.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <package android:name="com.pagasolutions.emergencycall_pl" />
        <package android:name="hzs.sk.hzs" />
        <package android:name="com.medicalit.zachranka" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!--
        `android:localeConfig` is read by Android 13+ only, which is what tools:targetApi records —
        it silences lint's "unused below minSdk" note without weakening anything at runtime. Older
        devices ignore the attribute and AppCompat's backport reads the same file, so the list of
        shipped languages stays in one place across the whole supported range (ADR-0004).

        Auto Backup runs through AppBackupAgent, which names its own file set (ADR-0005) — so
        `backup_rules.xml` and `data_extraction_rules.xml` are absent along with the attributes that
        would point at them. Static include/exclude XML cannot checkpoint the write-ahead log, and
        without that the platform is eligible to copy the live database and its `-wal` sidecar
        mid-write: a backup that appears to work and restores corrupt.

        `fullBackupOnly` is not optional beside `backupAgent`. Declaring an agent without it puts
        the app on the key/value path, where the agent's no-op onBackup is what runs.
    -->
    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:backupAgent=".AppBackupAgent"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.App"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".ui.common.ShareChosenReceiver"
            android:exported="false" />

        <!--
            The camera app writes the photo it takes into a file we own, and hands back a Uri for
            it. A file:// Uri has been illegal to pass across apps since Android 7, so this provider
            vends a content:// one instead, scoped to the single cache directory in file_paths.xml.
            Photo Picker needs none of this — it hands us a Uri of its own — but "take a photo"
            does. No CAMERA permission is declared on purpose: declaring it would make a camera
            *required* at install time, and firing the system camera intent needs none.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Not a service anybody starts — `android:enabled="false"` means it can never run. It is a
            manifest entry used as a storage slot: AppCompat looks itself up here, reads the
            `autoStoreLocales` flag, and takes responsibility for persisting the chosen language on
            devices below 13, where the platform has no per-app locale store of its own. On 13+ the
            framework persists it and this is ignored.

            Chosen over a DataStore key deliberately (ADR-0004): DataStore reads are asynchronous —
            a Flow, so `suspend` before the value exists — and the app would already have drawn its
            first frame in the phone's language before the stored one resolved.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
