<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only strings. `translatable="false"` on every one, for two reasons: Android lint would
    otherwise flag them as missing from every shipped locale, and `scripts/translation-gate.py`
    would ask you to translate a developer menu.

    This file is in `src/debug/res/`, so it is not merged into a release build at all.

    `app_name` is overridden here so the two copies on the phone are told apart at a glance.
    `applicationIdSuffix = ".debug"` already lets the debug build sit *beside* a Play copy, but both
    then carry the same name and icon — and picking the wrong one is how a local change gets tested
    against the store build, or a store bug gets chased in a build that never had it. A resource
    override rather than a `resValue`: `main/` already declares `app_name`, so a generated one would
    collide as a duplicate, while a debug `res/` overrides main's by name with no build logic at all.
    `scripts/project.py` reads this label back as DEBUG_APP_NAME, because OEM permission screens
    list the debug build under exactly this string.
-->
<resources>
    <string name="app_name" translatable="false">Kozica debug</string>
    <string name="debug_section" translatable="false">Debug</string>
    <string name="debug_seed" translatable="false">Seed sample data</string>
    <string name="debug_wipe" translatable="false">Delete all data</string>
    <string name="debug_region_reading" translatable="false">Regions: reading…</string>
    <string name="debug_region_not_downloaded" translatable="false">%1$s: not downloaded</string>
    <string name="debug_region_downloading" translatable="false">%1$s: downloading, %2$d %%</string>
    <string name="debug_region_updating" translatable="false">%1$s: updating, %2$d %%</string>
    <string name="debug_region_waiting" translatable="false">%1$s: waiting for Wi-Fi</string>
    <string name="debug_region_confirm" translatable="false">%1$s: Play needs a confirmation</string>
    <string name="debug_region_ready" translatable="false">%1$s: ready, OSM data of %2$s</string>
    <string name="debug_region_no_date" translatable="false">unknown date</string>
    <string name="debug_region_failed" translatable="false">%1$s: failed, error %2$d</string>
    <string name="debug_position_real" translatable="false">Use the real position</string>
    <string name="debug_gate_idle" translatable="false">Gate recorder: stopped</string>
    <string name="debug_gate_recording" translatable="false">Gate recorder: %1$d points, last fix %2$s</string>
    <string name="debug_gate_paused" translatable="false">Gate recorder: paused, %1$d points, motion sensor %2$s</string>
